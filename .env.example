# 포트원(PortOne) V2 결제 연동에 필요한 키. 실제 값은 .env로 복사해서 사용(.env는 git에 안 올라감).
# 관리자콘솔 > 결제 연동 > 연동 관리 > 식별코드·API Keys > [V2 API] 탭에서 확인.
PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 관리자콘솔 > 결제 연동 > 채널관리에서 사용할 채널을 클릭하면 확인 가능.
PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 서버 전용 비밀 키 — 절대 프론트엔드나 git에 노출하지 않는다.
PORTONE_API_SECRET=

# 이메일 인증(회원가입) 발송용 SMTP. Gmail이면 일반 로그인 비밀번호가 아니라
# 구글 계정 > 보안 > 앱 비밀번호에서 발급받은 값을 써야 함.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# 아래는 로컬 개발에서는 안 채워도 된다(docker-compose.yml에 이미 로컬용 기본값이 있음).
# 실제로 서버에 배포할 때만 이 값들을 채워서 .env로 넘긴다 → ADR-040 참고.
#
# Django SECRET_KEY. 아래 명령으로 새로 생성해서 쓴다(로컬 개발용 기본값을 배포에 그대로 쓰지 말 것):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# DEBUG=False로 꺼야 함(True로 배포하면 에러 화면에 코드·설정값이 그대로 노출됨).
DEBUG=False
# 배포한 서버의 퍼블릭 IP 또는 도메인, 쉼표로 여러 개 가능.
ALLOWED_HOSTS=xxx.xxx.xxx.xxx
# 프론트엔드가 실제로 서비스되는 주소(포트 포함). http:// 스킴까지 정확히.
CORS_ALLOWED_ORIGINS=http://xxx.xxx.xxx.xxx:3000
CSRF_TRUSTED_ORIGINS=http://xxx.xxx.xxx.xxx:3000

# docker-compose.prod.yml(프론트까지 컨테이너로 띄울 때)에서 빌드 시점에 사용. 값은
# frontend/.env.local.example과 같은 것 — 배포한 백엔드 주소로 바꿔서 채운다.
NEXT_PUBLIC_API_BASE_URL=http://xxx.xxx.xxx.xxx:8000
NEXT_PUBLIC_PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
